+def load_pilot_split(manifest_path: str | Path, split: str, feedback_count: int | None = None):
+    """Read the locked execution order, verify hashes, and never reshuffle."""
+    path = Path(manifest_path).resolve()
+    manifest = json.loads(path.read_text(encoding="utf-8"))
+    expected = {"train": 200, "score": 100, "feedback": 100, "audit": 100}
+    if manifest.get("schema_version") != 3 or not manifest.get("arrays_already_in_execution_order"):
+        raise ValueError("A v3 manifest in execution order is required")
+    if split not in expected:
+        raise ValueError(f"Unknown pilot split: {split}")
+    entry = manifest["splits"][split]
+    data_path = (path.parent / entry["file"]).resolve()
+    if data_path.parent != path.parent:
+        raise ValueError("Manifest split must stay inside its data directory")
+    raw = data_path.read_bytes()
+    if hashlib.sha256(raw).hexdigest() != entry["sha256"]:
+        raise ValueError(f"Data hash mismatch: {split}")
+    rows = [json.loads(line) for line in raw.decode("utf-8").splitlines() if line.strip()]
+    if len(rows) != entry["count"] or len(rows) != expected[split]:
+        raise ValueError(f"Wrong pilot panel size: {split}")
+    if [r["item_id"] for r in rows] != entry["item_ids"]:
+        raise ValueError("Panel order does not match manifest")
+    if split == "feedback":
+        if feedback_count not in (0, 50, 100):
+            raise ValueError("Feedback D must be 0, 50, or 100")
+        rows = rows[:feedback_count]
+    elif feedback_count is not None:
+        raise ValueError("feedback_count is only valid for feedback")
+    return wrap_lawbench_rows(rows), get_evaluator("LawBench")
 
 
