+    tmp = path.with_name(path.name + ".part-" + uuid.uuid4().hex)
+    with tmp.open("w", encoding="utf-8") as handle:
+        for row in rows:
+            handle.write(json.dumps(row, ensure_ascii=False) + "\n")
+    tmp.replace(path)
